# AirSense AI Backend Environment Configuration

# Environment ('development' or 'production')
ENVIRONMENT="development"

# Application Settings
PROJECT_NAME="AirSense AI"
API_V1_STR="/api"

# JWT Authentication Secret Key (Generate for production via: openssl rand -hex 32)
SECRET_KEY="airsense_ai_super_secret_jwt_key_2026_dev"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS Allowed Origins (Comma-separated URLs for allowed web clients)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Database Connection (MongoDB URI; automatically falls back to in-memory store if offline)
MONGODB_URL="mongodb://localhost:27017"
DATABASE_NAME="airsense_ai"

# Live Air Quality & Weather API Keys (Optional - gracefully falls back to deterministic telemetry if unconfigured)
# Obtain free WAQI token at https://aqicn.org/data-platform/token/
WAQI_API_TOKEN="demo"
# Obtain free OpenWeather key at https://openweathermap.org/api
OPENWEATHER_API_KEY=""

# OpenStreetMap OSRM Routing Service Base URL
OSRM_BASE_URL="https://router.project-osrm.org"
